@model IReadOnlyList<EventDto>
@{ViewData["Title"]="Discover events";}
<section class="hero mb-4">
    <div>
        <span class="eyebrow">MOVE WITH YOUR COMMUNITY</span>
        <h1>Every finish line<br/>starts with a <em>first step.</em>
        </h1>
        <p>Find your next running, cycling or walking event across South Africa.</p>
        <a class="btn btn-lime" asp-controller="Account" asp-action="Register">Create your free account</a>
    </div>
    <div class="hero-mark">RD<span>+</span>
    </div>
</section>
<form class="filter-bar mb-4" method="get">
    <input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search event or location"/>
    <select class="form-select" name="type">
        <option value="">All event types</option>
        @foreach(var t in new[]{"Running","Cycling","Walking"}){
            <option selected="@(ViewBag.Type==t)" value="@t">@t</option>
        }
    </select>
    <button class="btn btn-primary">Filter events</button>
</form>
@if(ViewBag.ApiError!=null){
    <div class="alert alert-warning">@ViewBag.ApiError</div>
}
<div class="section-head">
    <div>
        <span class="eyebrow">ON THE CALENDAR</span>
        <h2>Upcoming events</h2>
    </div>
    <span class="text-muted">@Model.Count events</span>
</div>
<div class="row g-4">
    @foreach(var e in Model){
        <div class="col-md-6 col-xl-4">
            <article class="event-card h-100">
                @if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){
                    <img class="event-banner" src="/Media/EventBanner/@e.EventID" alt="@e.EventName banner"/>
                }else{
                    <div class="event-placeholder">@e.EventType.ToUpperInvariant()</div>
                }
                <div class="p-4">
                    <span class="event-type">@e.EventType</span>
                    <h3>@e.EventName</h3>
                    <p class="text-muted">📍 @e.Location</p>
                    <p class="mb-3">📅 @e.EventDate.ToString("dd MMM yyyy · HH:mm")</p>
                    <a class="btn btn-outline-primary" asp-controller="Participant" asp-action="Details" asp-route-id="@e.EventID">View event</a>
                </div>
            </article>
        </div>
    }
</div>
