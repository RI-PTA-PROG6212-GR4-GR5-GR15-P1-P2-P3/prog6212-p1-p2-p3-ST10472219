<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>@ViewData["Title"] – RaceDay</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
        <link href="~/css/site.css" rel="stylesheet"/>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-raceday">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a>
                <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="nav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        @if(Context.Session.GetString("Role")=="Organiser"){
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Events">Events</a>
                            </li>
                        }else if(Context.Session.GetString("Role")=="Participant"){
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="Index">Find events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>
                            </li>
                        }else{
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Events</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex gap-2 align-items-center">
                        @if(Context.Session.GetInt32("UserId") is int){
                            <span class="text-white small">@Context.Session.GetString("FullName")</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        }else{
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-lime btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
        <main class="container py-4">
            @if(TempData["Notice"]!=null){
                <div class="alert alert-info">@TempData["Notice"]</div>
            }
            @RenderBody()</main>
        <footer class="container py-4 text-muted small border-top">RaceDay · South African running, cycling and walking events</footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
        </script>
    </body>
</html>
