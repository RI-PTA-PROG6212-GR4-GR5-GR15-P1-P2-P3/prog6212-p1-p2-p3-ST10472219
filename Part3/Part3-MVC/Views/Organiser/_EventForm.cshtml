@model EventVm
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="mb-3">
    <label asp-for="EventName" class="form-label"></label>
    <input asp-for="EventName" class="form-control"/>
    <span asp-validation-for="EventName" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="datetime-local" class="form-control"/>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option>Running</option>
            <option>Cycling</option>
            <option>Walking</option>
        </select>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Location" class="form-label"></label>
    <input asp-for="Location" class="form-control"/>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
<div class="mb-3">
    <label asp-for="Banner" class="form-label">Banner image (JPG, PNG or WEBP; max 5 MB)</label>
    <input asp-for="Banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/>
</div>
<input asp-for="EventID" type="hidden"/>
