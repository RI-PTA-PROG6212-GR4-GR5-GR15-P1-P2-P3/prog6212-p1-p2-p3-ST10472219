@model DashboardDto
@{ViewData["Title"]="Organiser dashboard";}
<div class="section-head">
    <div>
        <span class="eyebrow">ORGANISER WORKSPACE</span>
        <h1>Your dashboard</h1>
        <p class="text-muted">A quick view of your RaceDay events.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Create event</a>
</div>
@if(ViewBag.Error!=null){
    <div class="alert alert-warning">@ViewBag.Error</div>
}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <span>Events created</span>
            <strong>@Model.EventsCreated</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <span>Total enrolments</span>
            <strong>@Model.TotalEnrolments</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <span>Upcoming events</span>
            <strong>@Model.Events.Count(e=>e.EventDate>=DateTime.Today)</strong>
        </div>
    </div>
</div>
<h2 class="h4">Your event schedule</h2>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Enrolments</th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach(var e in Model.Events){
                <tr>
                    <td>@e.EventName</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.Enrolments</td>
                    <td>
                        <a asp-action="Enrolments" asp-route-id="@e.EventID">Enrolments</a> · <a asp-action="Results" asp-route-id="@e.EventID">Results</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
