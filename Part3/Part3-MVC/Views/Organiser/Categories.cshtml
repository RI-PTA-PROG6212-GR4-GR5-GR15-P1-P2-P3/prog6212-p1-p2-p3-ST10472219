@model IReadOnlyList<CategoryDto>
@{ViewData["Title"]="Event categories";}
<h1>Event categories</h1>
<p class="text-muted">Add distance or age-based entry categories. Distances determine the event's available routes.</p>
@if(ViewBag.Error!=null){
    <div class="alert alert-warning">@ViewBag.Error</div>
}
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Type</th>
                <th>Distance</th>
                <th>Age range</th>
                <th>Fee</th>
                <th>Entries</th>
                <th>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach(var c in Model){
                <tr>
                    <td>@c.CategoryName</td>
                    <td>@c.CategoryType</td>
                    <td>@c.DistanceKm km</td>
                    <td>@(c.MinimumAge.HasValue?c.MinimumAge+"–"+c.MaximumAge:"—")</td>
                    <td>R @c.EntryFee.ToString("N2")</td>
                    <td>@c.EnrolledCount / @c.MaxParticipants</td>
                    <td class="text-nowrap">
                        <details>
                            <summary>Edit</summary>
                            <form asp-action="UpdateCategory" method="post" class="p-2">
                                <input type="hidden" name="categoryId" value="@c.CategoryID"/>
                                <input type="hidden" name="eventId" value="@ViewBag.EventId"/>
                                <input name="CategoryName" value="@c.CategoryName" class="form-control form-control-sm mb-1" required/>
                                <select name="CategoryType" class="form-select form-select-sm mb-1">
                                    <option selected="@(c.CategoryType=="Distance")">Distance</option>
                                    <option selected="@(c.CategoryType=="Age")">Age</option>
                                </select>
                                <input name="DistanceKm" type="number" step="0.01" min="0.01" value="@c.DistanceKm" class="form-control form-control-sm mb-1"/>
                                <input name="MinimumAge" type="number" value="@c.MinimumAge" placeholder="Minimum age" class="form-control form-control-sm mb-1"/>
                                <input name="MaximumAge" type="number" value="@c.MaximumAge" placeholder="Maximum age" class="form-control form-control-sm mb-1"/>
                                <input name="EntryFee" type="number" step="0.01" value="@c.EntryFee" class="form-control form-control-sm mb-1"/>
                                <input name="MaxParticipants" type="number" min="1" value="@c.MaxParticipants" class="form-control form-control-sm mb-1"/>
                                <button class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </details>
                        <form asp-action="DeleteCategory" method="post">
                            <input type="hidden" name="categoryId" value="@c.CategoryID"/>
                            <input type="hidden" name="eventId" value="@ViewBag.EventId"/>
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="form-panel">
    <h2 class="h4">Add a category</h2>
    <form asp-action="AddCategory" method="post">
        <input type="hidden" name="EventID" value="@ViewBag.EventId"/>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Category name</label>
                <input name="CategoryName" class="form-control" required/>
            </div>
            <div class="col-md-3">
                <label class="form-label">Category type</label>
                <select name="CategoryType" class="form-select">
                    <option>Distance</option>
                    <option>Age</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Distance (km)</label>
                <input name="DistanceKm" type="number" min="0.01" step="0.01" value="5" class="form-control" required/>
            </div>
            <div class="col-md-2">
                <label class="form-label">Entry fee (R)</label>
                <input name="EntryFee" type="number" min="0" step="0.01" value="0" class="form-control"/>
            </div>
            <div class="col-md-2">
                <label class="form-label">Min age</label>
                <input name="MinimumAge" type="number" min="0" max="120" class="form-control"/>
            </div>
            <div class="col-md-2">
                <label class="form-label">Max age</label>
                <input name="MaximumAge" type="number" min="0" max="120" class="form-control"/>
            </div>
            <div class="col-md-2">
                <label class="form-label">Capacity</label>
                <input name="MaxParticipants" type="number" min="1" value="100" class="form-control"/>
            </div>
        </div>
        <button class="btn btn-primary mt-3">Add category</button>
    </form>
</div>
