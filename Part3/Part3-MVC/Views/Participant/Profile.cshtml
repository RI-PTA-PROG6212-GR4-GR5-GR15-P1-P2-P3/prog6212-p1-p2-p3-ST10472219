@model ProfileVm
@{ViewData["Title"]="My profile";}
<h1>My profile</h1>
<div class="form-panel">
    @if(!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)){
        <img src="/Media/ProfilePicture" alt="Your profile picture" class="profile-picture mb-3"/>
    }
    <form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="Picture" class="form-label">Profile picture (JPG, PNG or WEBP; max 5 MB)</label>
            <input asp-for="Picture" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/>
        </div>
        <button class="btn btn-primary">Save profile</button>
    </form>
</div>
